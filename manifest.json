{
  "manifest_version": 3,
  "name": "ExportAI",
  "version": "0.1.0",
  "description": "Export AI chat conversations from ChatGPT, Grok, and Gemini to AI-ready files.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ExportAI"
  },
  "side_panel": {
    "default_path": "manager.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/chat*",
        "https://devin.ai/*",
        "https://app.devin.ai/*",
        "https://lovable.dev/*",
        "https://www.lovable.dev/*"
      ],
      "js": ["src/shared/platforms.js", "src/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "alarms", "downloads", "scripting", "sidePanel", "storage", "tabs", "windows"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://claude.ai/*",
    "https://copilot.microsoft.com/*",
    "https://www.bing.com/chat*",
    "https://devin.ai/*",
    "https://app.devin.ai/*",
    "https://lovable.dev/*",
    "https://www.lovable.dev/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ]
}
